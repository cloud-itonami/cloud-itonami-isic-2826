;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README: an ISIC 2826 plant assembles and tests weaving looms, industrial
;; sewing machines, leather-cutting, knitting and fabric-cutting machines
;; (robotics authority: full, HARD-gated, human sign-off on every actuation).
;; The physical work around that plant: an assembly arm setting sewing-machine
;; heads onto their tables, powder-coat curing of cast-iron loom side frames,
;; and an AMR moving crated machines to the shipping dock.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-2826"
 :cases
 [{:id :set-sewing-head-on-table
   :kind :manipulator
   :procedure "assembly arm lifts an industrial sewing-machine head from the conveyor and sets it into its table cut-out"
   :params {:l1-m 0.60 :l2-m 0.50 :m1-kg 9.0 :m2-kg 6.0
            :from [0.65 0.00] :to [0.30 0.55] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [8.0 12.0 16.0 20.0 25.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 250.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload industrial arm class"}
   :boundary {:lo 1.0 :hi 60.0}}
  {:id :loom-frame-powder-cure
   :kind :thermal
   :procedure "cast-iron loom side frame, powder-coated, heats in a 200 C convection cure oven until its far face reaches the 180 C cure temperature"
   :params {:conductivity-w-mk 50.0 :density-kg-m3 7200.0 :specific-heat-j-kgk 460.0
            :t0-c 20.0 :t-hot-c 200.0 :h-front-w-m2k 30.0 :t-back-ambient-c 200.0 :h-back-w-m2k 30.0
            :threshold-c 180.0 :duration-s 5400.0 :nodes 6}
   :sweep {:param :thickness-m :values [0.008 0.012 0.020 0.030 0.040]}
   :quantity :time-to-threshold-s
   :limit {:max 1500.0 :basis "estimate: a 35-minute oven dwell less the ~10-minute at-temperature hold typical of polyester powder-coat datasheets"}
   :boundary {:lo 0.004 :hi 0.08}}
  {:id :crated-loom-to-dock
   :kind :transport
   :procedure "AMR carries a crated knitting machine from the test bench to the shipping dock (70 m)"
   :params {:mass-kg 300.0 :distance-m 70.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 500.0 :crr 0.015
            :cog-height-m 0.40 :support-half-length-m 0.45 :payload-cog-height-m 1.00
            :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [150.0 300.0 600.0 900.0 1300.0]}
   :quantity :cycle-time-s
   :limit {:max 100.0 :basis "estimate: one dock run inside a 2-minute truck-loading takt"}
   :boundary {:lo 50.0 :hi 4000.0}}]}
